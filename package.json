{
  "name": "dread-stone-black",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run validate:reliquary-startup && tsc -b && vite build",
